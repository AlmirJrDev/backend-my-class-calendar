# ---- Banco ----
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/calendario

# ---- Autenticação ----
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRE=30d

# ---- Front ----
# Origem liberada no CORS. Obrigatório: sem isso a API rejeita o navegador.
FRONTEND_URL=https://my-class-calendar.vercel.app

# ---- Email (SMTP) ----
EMAIL_HOST=smtp.exemplo.com
EMAIL_PORT=465
EMAIL_USER=conta@exemplo.com
EMAIL_PASS=senha-de-app

# Remetente exibido no email. Se não definir, cai em EMAIL_USER e no nome
# padrão "Calendário de Aulas".
FROM_NAME=Calendário de Aulas
FROM_EMAIL=conta@exemplo.com

# ---- Admin inicial (usado por npm run create-admin) ----
ADMIN_EMAIL=admin@exemplo.com
ADMIN_NAME=Administrador

# ---- Servidor ----
PORT=5000
# development habilita o log do morgan e o detalhe dos erros na resposta.
NODE_ENV=development
