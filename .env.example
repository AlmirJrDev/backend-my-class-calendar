# ---- Banco ----
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/calendario

# ---- Autenticação ----
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRE=30d

# ---- Front ----
# Origem liberada no CORS. Obrigatório: sem isso a API rejeita o navegador.
FRONTEND_URL=https://my-class-calendar.vercel.app

# ---- Email (SMTP) ----
EMAIL_HOST=smtp.exemplo.com
EMAIL_PORT=465
EMAIL_USER=conta@exemplo.com
EMAIL_PASS=senha-de-app

# Remetente exibido no email. Se não definir, cai em EMAIL_USER e no nome
# padrão "My Class Calendar".
#
# Com Resend (ou outro serviço de envio), o usuário do SMTP não é um e-mail,
# então FROM_EMAIL é obrigatório e precisa ser do domínio verificado lá:
#   EMAIL_HOST=smtp.resend.com
#   EMAIL_PORT=465
#   EMAIL_USER=resend
#   EMAIL_PASS=re_...            (chave de API com permissão só de envio)
#   FROM_EMAIL=nao-responda@seudominio.com.br
#   REPLY_TO_EMAIL=uma caixa que alguém lê
FROM_NAME=My Class Calendar
FROM_EMAIL=conta@exemplo.com
# Para onde vão as respostas. Se não definir, usa FROM_EMAIL.
REPLY_TO_EMAIL=conta@exemplo.com

# ---- Admin inicial (usado por npm run create-admin) ----
ADMIN_EMAIL=admin@exemplo.com
ADMIN_NAME=Administrador

# ---- Servidor ----
PORT=5000
# development habilita o log do morgan e o detalhe dos erros na resposta.
NODE_ENV=development
